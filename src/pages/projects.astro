---
import BaseLayout from '@/layouts/BaseLayout.astro'

const projects = [
  { name: 'Scrawl', href: 'https://playground.deore.me/', desc: 'TS/JS Playground，支持预览 HTML 和 Markdown', github: 'https://github.com/bohecola/scrawl' },
  { name: 'NTodo', href: 'https://todo.deore.me/', desc: '使用 React + TS 实现的一个 TodoList，基础操作习惯参考了 Microsoft To Do', github: 'https://github.com/bohecola/naive-todo' },
  { name: 'README Stats Playground', href: 'https://readme-stats.deore.me/', desc: '可视化配置 GitHub 主页的统计卡片', github: 'https://github.com/bohecola/readme-stats-playground' },
]
---

<BaseLayout title="Projects">
  <h1>Projects</h1>

    <ul>
      {
        projects.map((project) => {
          return (
            <li>
              <a href={project.href} class="text-lg" target="_blank">
                {project.name}
              </a>
              <a
                title="Github"
                href={project.github}
                target="_blank"
                aria-label={`${project.name} github repository`}
                class="not-prose ml-2"
              >
                <span class="i-carbon-logo-github" />
              </a>
              <p class="text-sm">{project.desc}</p>
            </li>
          )
        })
      }
    </ul>
</BaseLayout>
